rules_version = '2';

// The site never reads Firestore from the browser — content is fetched
// server-side with the Admin SDK, which bypasses these rules entirely, and
// enquiries are written through the app's own API route.
//
// So the correct client-side policy is: deny everything. If a rule here ever
// needs to open up, that means something started talking to Firestore directly
// from a browser, which is worth questioning first.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
