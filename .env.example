# Copy to .env.local and fill in. Nothing here is required to run the marketing
# site — without it the site renders its built-in copy and the admin panel says
# so rather than breaking.

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Used for canonical URLs, Open Graph tags and the sitemap.
NEXT_PUBLIC_SITE_URL=https://aurevia.in

# ---------------------------------------------------------------------------
# Firebase — content storage and admin sign-in
# ---------------------------------------------------------------------------
# Server (Firebase console → Project settings → Service accounts → Generate key).
# Keep the private key's \n escapes and wrap the whole value in double quotes.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Browser (Firebase console → Project settings → Your apps → Web app config).
# These are public by design; access is controlled by the allowlist below.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# Comma-separated emails allowed into /admin. Create the accounts in
# Firebase console → Authentication → Users (Email/Password provider).
# Leave this empty and nobody can sign in — that is the safe default.
ADMIN_EMAILS=you@example.com

# ---------------------------------------------------------------------------
# Cloudinary — photography
# ---------------------------------------------------------------------------
# The cloud name is needed in the browser to build image URLs; the key and
# secret stay on the server and only ever sign one upload at a time.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
